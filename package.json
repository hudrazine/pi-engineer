{
  "name": "pi-engineer",
  "version": "0.0.0",
  "description": "A starter for creating a TypeScript package.",
  "keywords": [
    "codex",
    "pi",
    "pi-package",
    "system-prompt"
  ],
  "homepage": "https://github.com/hudrazine/pi-engineer#readme",
  "bugs": {
    "url": "https://github.com/hudrazine/pi-engineer/issues"
  },
  "license": "MIT",
  "author": "hudrazine",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hudrazine/pi-engineer.git"
  },
  "files": [
    "src"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run check && vp run test"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@earendil-works/pi-tui": "^0.84.2",
    "@types/node": "^26.1.1",
    "bumpp": "^11.1.0",
    "typebox": "^1.3.14",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
