+import { parseLimit } from "./limits.js";
+
+function parseLimitWithFallback(value) {
+  try {
+    return parseLimit(value);
+  } catch {
+    return 10;
+  }
+}
+
+export function loadBatchConfig(env) {
+  return { batchLimit: parseLimitWithFallback(env.BATCH_LIMIT ?? "10") };
+}
+
+export function normalizeBatchLimit(value) {
+  return parseLimitWithFallback(value);
+}
