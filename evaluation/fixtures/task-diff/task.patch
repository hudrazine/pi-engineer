+import assert from "node:assert/strict";
+import test from "node:test";
+import { loadBatchConfig } from "../src/config.js";
+
+test("loads the default batch limit", () => {
+  assert.deepEqual(loadBatchConfig({}), { batchLimit: 10 });
+});
+
+test("loads a configured batch limit", () => {
+  assert.deepEqual(loadBatchConfig({ BATCH_LIMIT: "25" }), { batchLimit: 25 });
+});
